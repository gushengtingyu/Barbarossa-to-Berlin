{
	"name": "barbarossa-to-berlin",
	"version": "0.1.0",
	"private": true,
	"description": "WWII: Barbarossa to Berlin game module",
	"main": "rules.js",
	"scripts": {
		"python:sync": "uv sync",
		"assets:cards": "node tools/run_python.js tools/slice_cards.py",
		"assets:cover": "node tools/run_python.js tools/build_cover_assets.py",
		"assets:map": "node tools/run_python.js tools/build_map_asset.py",
		"import:vassal": "node tools/import_vassal.js --write",
		"import:rulebook-cards": "node tools/import_rulebook_cards.js --write",
		"import:vassal-units": "node tools/materialize_vassal_units.js --write",
		"extract:rulebook": "node tools/run_python.js tools/extract_rulebook.py",
		"build:data": "node tools/build_data.js",
		"build:i18n": "node tools/build_i18n.js",
		"validate:data": "node tools/build_data.js --check",
		"validate:i18n": "node tools/build_i18n.js --check",
		"report:progress": "node tools/report_progress.js",
		"report:coverage": "node tools/report_coverage.js",
		"report:coverage:update": "node tools/report_coverage.js --write",
		"prebuild:rally": "npm run build:data && npm run build:i18n",
		"build:rally": "node tools/prepare_rally_source.js",
		"preintegrate:rally": "npm run build:rally",
		"integrate:rally": "node tools/integrate_rally.js",
		"start:map-editor": "node tools/dev_server.js",
		"pretest": "npm run build:data && npm run build:i18n",
		"test": "node --test",
		"test:coverage": "node --test --experimental-test-coverage",
		"test:fuzz": "node tests/runtime_fuzz_loop.js 1000",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write \"modules/**/*.js\" \"tests/**/*.js\" \"tools/**/*.js\" \"*.js\" \"*.html\" \"*.css\" \"*.json\"",
		"format:check": "prettier --check \"modules/**/*.js\" \"tests/**/*.js\" \"tools/**/*.js\" \"*.js\" \"*.html\" \"*.css\" \"*.json\"",
		"check:deps": "depcruise rules.js modules --config .dependency-cruiser.cjs",
		"typecheck": "tsc -p jsconfig.json",
		"validate:rally": "node tools/prepare_rally_source.js",
		"check": "npm run validate:data && npm run validate:i18n && npm run check:deps && npm run typecheck && npm run lint && npm run format:check && npm test && npm run validate:rally && npm run report:coverage"
	},
	"engines": {
		"node": ">=22"
	},
	"devDependencies": {
		"@eslint/js": "9.19.0",
		"@types/node": "22.20.1",
		"dependency-cruiser": "18.1.0",
		"eslint": "9.19.0",
		"eslint-config-prettier": "9.1.0",
		"linkedom": "0.18.13",
		"prettier": "3.4.2",
		"typescript": "7.0.2"
	}
}
